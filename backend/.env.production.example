# =============================================================================
# Energy Tail — production environment
# =============================================================================
# Copy to .env on the server and fill in the real values.
# Never commit the completed file: it holds database and mail credentials.
#
# After editing, run:
#   php artisan config:cache && php artisan route:cache
# =============================================================================

APP_NAME="Energy Tail"
APP_ENV=production

# Generate on the server with: php artisan key:generate
# Changing this later invalidates every encrypted value and active session.
APP_KEY=

# Must be false in production. When true, a stack trace with database
# credentials is returned to anyone who triggers an error.
APP_DEBUG=false

# The API's own address. Signed URLs — email verification in particular —
# include the host in the signature, so this must match exactly how users
# reach the API. A mismatch (http vs https, www vs bare, an IP instead of the
# hostname) makes every verification link fail with "invalid or expired".
APP_URL=https://api.energytail.com

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Where the Next.js app is served. Drives CORS, and is the origin users are
# returned to after an OAuth sign-in.
FRONTEND_URL=https://energytail.com

# Cookie authentication only works when the API and frontend share a root
# domain. api.energytail.com and energytail.com do; a different domain does
# not, and would need token auth instead.
SANCTUM_STATEFUL_DOMAINS=energytail.com,www.energytail.com
SESSION_DOMAIN=.energytail.com

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=energytail
DB_USERNAME=energytail
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions, cache and queues
# -----------------------------------------------------------------------------
# 'database' works everywhere including shared hosting. Switch all three to
# 'redis' once Redis is available — it is markedly faster under load.
# Pinned so the frontend proxy can look for a stable cookie name. Laravel
# otherwise derives it from APP_NAME, and renaming the app would silently
# break route protection on the frontend.
SESSION_COOKIE=energy-tail-session

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# HTTPS only. Without this the session cookie can travel over plain HTTP.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
# Verification and password reset emails depend on this. If it is wrong,
# registration appears to work but nobody can confirm their address.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@energytail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend or Postmark instead of SMTP:
# MAIL_MAILER=resend
# RESEND_API_KEY=

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# 'public' stores uploads on the server disk. Switch to 's3' for Cloudflare R2
# or AWS once media volume grows.
FILESYSTEM_DISK=public

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# AWS_URL=https://cdn.energytail.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# -----------------------------------------------------------------------------
# Social sign-in
# -----------------------------------------------------------------------------
# Redirect URIs must match what is registered with each provider exactly,
# including the scheme and any trailing path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.energytail.com/api/v1/auth/social/google/callback

# LinkedIn's OpenID Connect product requires app review before it issues
# production credentials. Sign-in stays unavailable until that is approved.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.energytail.com/api/v1/auth/social/linkedin/callback

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# 'daily' keeps 14 days of rotated files rather than one file growing without
# limit until it fills the disk.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
