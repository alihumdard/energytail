# Copy to .env.local for local development.
#
# NEXT_PUBLIC_ variables are inlined into the browser bundle, so they must
# never hold secrets. The API base URL is fine — it is visible in the network
# tab regardless.

# Laravel API root, without a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where this frontend is served. Used to build absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# reCAPTCHA v3 site key. Leave blank to disable — the forms then send no
# token, which matches a backend running with CAPTCHA_ENABLED=false.
# Must be the site key that pairs with the backend's CAPTCHA_SECRET.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
